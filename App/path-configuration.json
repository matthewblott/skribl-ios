{
  "settings": {
  },
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/\\d+/notes$"
      ],
      "properties": {
        "presentation": "replace_root"
      }
    },
    {
      "patterns": [
        "/\\d+/notes\\?note_deleted=1$"
      ],
      "properties": {
        "uri": "hotwire://fragment/web",
        "presentation": "replace_root"
      }
    },
    {
      "patterns": [
        "/\\d+/notes/new$"
      ],
      "properties": {
        "uri": "hotwire://fragment/web",
        "presentation": "replace_root",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/\\d+/notes/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
